APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Australia/Sydney

# Storage driver: json (default, no database needed), database, or auto (try DB, fall back to json)
STORAGE_DRIVER=json

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=phpbaseplate
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
LOG_CHANNEL=file
