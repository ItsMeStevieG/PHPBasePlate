{% extends "layouts/base.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<h1 class="mb-4">News</h1>

{% if entries is empty %}
<p class="text-muted">No articles published yet.</p>
{% else %}
<div class="row">
    {% for entry in entries %}
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <a href="/news/{{ entry.slug }}" class="text-decoration-none">{{ entry.title }}</a>
                </h5>
                {% if entry.payload.category is defined and entry.payload.category %}
                <span class="badge bg-secondary mb-2">{{ entry.payload.category }}</span>
                {% endif %}
                {% if entry.payload.featured is defined and entry.payload.featured %}
                <span class="badge bg-warning text-dark mb-2">Featured</span>
                {% endif %}
                <p class="card-text">
                    {{ (entry.payload.excerpt | default(entry.summary | default(''))) | excerpt(200) }}
                </p>
            </div>
            <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                <a href="/news/{{ entry.slug }}" class="btn btn-sm btn-outline-primary">Read more</a>
                <small class="text-muted">{{ entry.published_at | time_ago }}</small>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

{% if pagination.total_pages > 1 %}
<nav class="mt-4">
    <ul class="pagination justify-content-center">
        {% if pagination.page > 1 %}
        <li class="page-item">
            <a class="page-link" href="/news?page={{ pagination.page - 1 }}">Previous</a>
        </li>
        {% endif %}
        {% for p in range(1, pagination.total_pages) %}
        <li class="page-item {{ p == pagination.page ? 'active' : '' }}">
            <a class="page-link" href="/news?page={{ p }}">{{ p }}</a>
        </li>
        {% endfor %}
        {% if pagination.page < pagination.total_pages %}
        <li class="page-item">
            <a class="page-link" href="/news?page={{ pagination.page + 1 }}">Next</a>
        </li>
        {% endif %}
    </ul>
</nav>
{% endif %}
{% endif %}
{% endblock %}
