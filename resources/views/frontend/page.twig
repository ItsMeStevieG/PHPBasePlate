{% extends "layouts/base.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block head %}
{% if meta_description %}
<meta name="description" content="{{ meta_description }}">
{% endif %}
{% endblock %}

{% block content %}
<article class="py-4">
    <h1>{{ page.title }}</h1>

    {% if page.payload.body is defined %}
    <div class="content mt-4">
        {{ page.payload.body | raw }}
    </div>
    {% endif %}
</article>
{% endblock %}
