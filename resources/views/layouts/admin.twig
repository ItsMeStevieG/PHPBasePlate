<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Admin{% endblock %} | PHPBasePlate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YcnS/1VnQryNg+T6+w2VcIkB5JMiB/sLBS7a"
          crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .sidebar { min-height: calc(100vh - 56px); }
        .sidebar .nav-link { color: #333; padding: .4rem 1rem; font-size: .9rem; }
        .sidebar .nav-link:hover { background: #e9ecef; }
        .sidebar .nav-link.active { background: #0d6efd; color: #fff; border-radius: .25rem; }
        .sidebar .nav-section { font-size: .75rem; text-transform: uppercase; color: #6c757d;
                                padding: .75rem 1rem .25rem; font-weight: 600; }
        .content-area { min-height: calc(100vh - 56px); }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/admin">PHPBasePlate</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNav">
                <ul class="navbar-nav ms-auto">
                    {% if user is defined and user %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> {{ user.name }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form method="post" action="/admin/logout">
                                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 sidebar bg-light border-end pt-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a>
                    </li>
                </ul>

                {% if content_types is defined and content_types %}
                <div class="nav-section">Content</div>
                <ul class="nav flex-column">
                    {% for name, ct in content_types %}
                    <li class="nav-item">
                        <a class="nav-link {% if type is defined and type == name %}active{% endif %}"
                           href="/admin/content/{{ name }}">
                            <i class="bi {{ ct.admin.icon | default('bi-file-text') }}"></i> {{ ct.label }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}

                <div class="nav-section">System</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/media"><i class="bi bi-image"></i> Media</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/menus"><i class="bi bi-list-nested"></i> Menus</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/settings"><i class="bi bi-gear"></i> Settings</a>
                    </li>
                </ul>
            </nav>

            <main class="col-md-10 content-area p-4">
                {% if flash_success is defined and flash_success %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ flash_success }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                {% endif %}

                {% if flash_error is defined and flash_error %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ flash_error }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                {% endif %}

                {% block content %}{% endblock %}
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
