{% extends "layouts/admin.twig" %}

{% block title %}Dashboard{% endblock %}

{% block content %}
<h2>Dashboard</h2>
<p class="text-muted">Welcome back, {{ user.name }}.</p>

<div class="row mt-4">
    {% for name, ct in content_types %}
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi {{ ct.admin.icon | default('bi-file-text') }}"></i> {{ ct.label }}</h5>
                <p class="card-text text-muted">{{ ct.mode | capitalize }} content type</p>
                <a href="/admin/content/{{ name }}" class="btn btn-primary btn-sm">Manage</a>
                <a href="/admin/content/{{ name }}/create" class="btn btn-outline-primary btn-sm">Create New</a>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endblock %}
