{% extends "layouts/admin.twig" %}

{% block title %}Dashboard{% endblock %}

{% block content %}
<h2>Dashboard</h2>
<p class="text-muted">Welcome back, {{ user.name }}.</p>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card text-bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Content</h5>
                <p class="card-text">Manage content types and entries.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-secondary mb-3">
            <div class="card-body">
                <h5 class="card-title">Media</h5>
                <p class="card-text">Upload and manage files.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-dark mb-3">
            <div class="card-body">
                <h5 class="card-title">Settings</h5>
                <p class="card-text">Configure site settings.</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
