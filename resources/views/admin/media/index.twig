{% extends "layouts/admin.twig" %}

{% block title %}Media{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-image"></i> Media Library</h2>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="post" action="/admin/media/upload" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <div class="row align-items-end">
                <div class="col-md-8">
                    <label for="file" class="form-label">Upload File</label>
                    <input type="file" name="file" id="file" class="form-control" required>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-upload"></i> Upload
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

{% if files is empty %}
<p class="text-muted">No files uploaded yet.</p>
{% else %}
<div class="row">
    {% for file in files %}
    <div class="col-md-3 mb-4">
        <div class="card h-100">
            {% if file.mime_type starts with 'image/' %}
            <img src="/uploads/{{ file.path }}" class="card-img-top" alt="{{ file.alt_text | default(file.original_name) }}"
                 style="height: 150px; object-fit: cover;">
            {% else %}
            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
                <i class="bi bi-file-earmark display-4 text-muted"></i>
            </div>
            {% endif %}
            <div class="card-body p-2">
                <p class="card-text small text-truncate mb-1" title="{{ file.original_name }}">{{ file.original_name }}</p>
                <p class="card-text small text-muted mb-0">
                    {{ file.extension | upper }} &middot; {{ (file.size_bytes / 1024) | round(1) }} KB
                    {% if file.width %} &middot; {{ file.width }}&times;{{ file.height }}{% endif %}
                </p>
            </div>
            <div class="card-footer p-2">
                <form method="post" action="/admin/media/{{ file.id }}/delete"
                      onsubmit="return confirm('Delete this file?')">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

{% if pagination.total_pages > 1 %}
<nav>
    <ul class="pagination justify-content-center">
        {% for p in range(1, pagination.total_pages) %}
        <li class="page-item {{ p == pagination.page ? 'active' : '' }}">
            <a class="page-link" href="/admin/media?page={{ p }}">{{ p }}</a>
        </li>
        {% endfor %}
    </ul>
</nav>
{% endif %}
{% endif %}
{% endblock %}
