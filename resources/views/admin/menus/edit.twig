{% extends "layouts/admin.twig" %}

{% block title %}Edit {{ menu.label }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-list-nested"></i> {{ menu.label }}</h2>
    <a href="/admin/menus" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<form method="post" action="/admin/menus/{{ menu.machine_name }}">
    <input type="hidden" name="_token" value="{{ csrf_token }}">

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            Menu Items
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addMenuItem()">
                <i class="bi bi-plus"></i> Add Item
            </button>
        </div>
        <div class="card-body">
            <div id="menu-items">
                {% for item in items %}
                <div class="row mb-2 menu-item align-items-center">
                    <div class="col-md-4">
                        <input type="text" name="label[]" class="form-control form-control-sm"
                               value="{{ item.label }}" placeholder="Label">
                    </div>
                    <div class="col-md-3">
                        <select name="item_type[]" class="form-select form-select-sm">
                            <option value="internal" {{ item.item_type == 'internal' ? 'selected' : '' }}>Internal</option>
                            <option value="external" {{ item.item_type == 'external' ? 'selected' : '' }}>External</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <input type="text" name="url[]" class="form-control form-control-sm"
                               value="{{ item.url }}" placeholder="URL">
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.menu-item').remove()">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>
                {% endfor %}
            </div>

            {% if items is empty %}
            <p class="text-muted" id="no-items-msg">No items yet. Click "Add Item" to start.</p>
            {% endif %}
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-save"></i> Save Menu
    </button>
</form>
{% endblock %}

{% block scripts %}
<script>
function addMenuItem() {
    var msg = document.getElementById('no-items-msg');
    if (msg) msg.remove();

    var container = document.getElementById('menu-items');
    var row = document.createElement('div');
    row.className = 'row mb-2 menu-item align-items-center';
    row.innerHTML = '<div class="col-md-4"><input type="text" name="label[]" class="form-control form-control-sm" placeholder="Label"></div>'
        + '<div class="col-md-3"><select name="item_type[]" class="form-select form-select-sm"><option value="internal">Internal</option><option value="external">External</option></select></div>'
        + '<div class="col-md-4"><input type="text" name="url[]" class="form-control form-control-sm" placeholder="URL"></div>'
        + '<div class="col-md-1"><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest(\'.menu-item\').remove()"><i class="bi bi-x"></i></button></div>';
    container.appendChild(row);
}
</script>
{% endblock %}
