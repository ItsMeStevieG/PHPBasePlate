{
    "name": "itsmesteview/phpbaseplate",
    "description": "A reusable, API-first PHP content platform",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "twig/twig": "^3.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "ItsMeStevieG\\PHPBasePlate\\": "app/"
        },
        "files": [
            "bootstrap/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ItsMeStevieG\\PHPBasePlate\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse app/ --level=6"
    }
}
